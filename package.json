{
  "name": "mind-blast",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=server.mjs server.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --test tests/world.test.mjs",
    "test:browser": "playwright test",
    "test:network": "node --test tests/network.test.mjs",
    "format": "prettier --write src server.mjs index.html tests playwright.config.js vite.config.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "three": "0.187.0",
    "vite": "8.3.7",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "prettier": "3.9.10"
  },
  "description": "A seeded voxel demolition playground with Rapier physics and LAN multiplayer",
  "engines": {
    "node": ">=22.12.0"
  }
}
